#!/usr/bin/env bash
# Profil developpement : corpus minimal, verifications rapides, API locale.
# Aucun service externe obligatoire, aucune publication de resultats.
set -euo pipefail
cd "$(dirname "$0")"

if [[ "${1:-}" == "--docker" ]]; then
  exec docker compose -f docker-compose.dev.yml up --build
fi

uv sync --extra dev
uv run ruff check src tests
uv run mypy
uv run pytest -m "not models and not slow"
uv run ivr-bench doctors generate --seed 42 --profile dev
uv run ivr-bench data generate --seed 42 --profile dev
uv run ivr-bench data validate
exec uv run uvicorn ivr_bench.api.app:app --host 127.0.0.1 --port 8000 --reload
